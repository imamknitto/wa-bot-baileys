{
  "name": "wa-bot-platform",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./packages/api --filter ./packages/web dev",
    "dev:api": "pnpm --filter ./packages/api dev",
    "dev:web": "pnpm --filter ./packages/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter ./packages/api start",
    "smoke": "pnpm --filter ./packages/api smoke",
    "smoke:http": "pnpm --filter ./packages/api smoke:http",
    "smoke:migrate": "pnpm --filter ./packages/api smoke:migrate"
  }
}

# Copy to .env, then set API_KEY to a random value.

# HTTP
PORT=8365
HOST=0.0.0.0
# SERVE_WEB=false stops the api from serving packages/web/dist at /app (api dev mode sets this automatically).
# SERVE_WEB=true
API_KEY=change-me

# Storage (single SQLite file: auth + broadcast + message_log + webhook_events)
DB_PATH=data/app.db

# Limits
MAX_SESSIONS=10
LOG_RETENTION_DAYS=30

# Webhook back to the remarketing app (optional; disabled when WEBHOOK_URL is empty).
# WEBHOOK_SECRET is required when WEBHOOK_URL is set.
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETENTION_DAYS=7
